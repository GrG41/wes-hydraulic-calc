{
  "name": "wes-hydraulic-calc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WES 型实用堰泄流能力与堰流水面线计算程序（按 SL 253-2018）",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && pnpm run gen:verification && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:verification": "node scripts/gen-verification-page.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "verify": "pnpm run build && node scripts/verify-pwa.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "verify:all": "pnpm run build && node scripts/verify-pwa.mjs && node scripts/acceptance.mjs",
    "deploy:pages": "bash scripts/deploy-pages.sh"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "decimal.js": "^10.6.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
